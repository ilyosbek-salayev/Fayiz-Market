{
  "name": "@fayz/desktop",
  "version": "1.1.0",
  "description": "Fayz Market administrator desktop app",
  "author": "Fayz Market",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "npm run build -w @fayz/admin --prefix ../.. && node ../../scripts/copy-admin.mjs",
    "pack:mac": "npm run prepare:web && electron-builder --mac dmg --arm64",
    "pack:windows": "npm run prepare:web && electron-builder --win nsis --x64"
  },
  "devDependencies": {"electron": "^36.0.0", "electron-builder": "^26.0.0"},
  "build": {
    "appId": "uz.fayzmarket.admin",
    "electronVersion": "36.9.5",
    "productName": "Fayz Market Admin",
    "copyright": "Fayz Market",
    "directories": {"output": "release", "buildResources": "build"},
    "files": ["main.cjs", "preload.cjs", "api-url.json", "web/**/*", "build/icon.png", "package.json"],
    "mac": {"target": [{"target": "dmg", "arch": ["arm64"]}], "category": "public.app-category.business", "icon": "build/icon.png", "identity": "-", "hardenedRuntime": false, "artifactName": "Fayz-Market-Admin-macOS.${ext}"},
    "dmg": {"title": "Fayz Market Admin"},
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "build/icon.png", "artifactName": "Fayz-Market-Admin-Setup.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Fayz Market Admin", "uninstallDisplayName": "Fayz Market Admin"}
  }
}
