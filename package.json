{
  "name": "fayz-market",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:api": "npm run dev -w @fayz/api",
    "dev:admin": "npm run dev -w @fayz/admin",
    "build:admin": "npm run build -w @fayz/admin"
  },
  "devDependencies": {"sharp": "^0.34.0", "typescript": "^5.8.3", "vitest": "^3.2.4"}
}
